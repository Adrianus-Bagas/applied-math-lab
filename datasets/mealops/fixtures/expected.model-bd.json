{
  "source": "docs/mathematics/mealops/model.md §4.8, §4.10, §6.6, §7.3, §7.5, §7.8, §7.9",
  "note": "Belum ada oracle. Diverifikasi hitung tangan dan enumerasi independen (MO-1.6). Jarak dalam meter, holding dalam porsi·menit. Rencana: vehicles = daftar kendaraan, tiap kendaraan = daftar trip berurutan, tiap trip = daftar node; batches = daftar batch berurutan.",
  "cases": [
    {
      "name": "H5-rho2",
      "base": "h5.instance.json",
      "patch": [
        { "op": "replace", "path": "/fleet/max_trips", "value": 2 },
        { "op": "replace", "path": "/fleet/load_time", "value": 10 }
      ],
      "model": "B",
      "used_by": "MO-11",
      "expect": {
        "feasible_count": 41,
        "multi_trip_count": 32,
        "optimum": 3200
      }
    },
    {
      "name": "H5-S",
      "base": "h5s.instance.json",
      "patch": [],
      "model": "B",
      "used_by": "MO-11",
      "expect": {
        "feasible_count": 8,
        "optimum": 4600,
        "optimum_count": 2,
        "optimal_plans": [
          { "vehicles": [[[2], [3]], [[4, 6, 1, 5]]] },
          { "vehicles": [[[2], [5]], [[4, 6, 1, 3]]] }
        ]
      }
    },
    {
      "name": "H5-S-lambda20",
